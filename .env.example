# Which Tachi network the app uses: regtest (default) or signet
TACHI_NETWORK=regtest

# Treasury agent key (hex). Leave empty: the dashboard's "Create treasury" or `npm run fund` fills it in.
TACHI_AGENT_SECRET_KEY=

# Regtest — Tachi daemon and its bitcoind (for deposits)
REGTEST_BTC_NODES=
PUBLIC_REGTEST_BTC_RPC_URL=
REGTEST_BTC_RPC_USERNAME=
REGTEST_BTC_RPC_PASSWORD=
TACHI_REGTEST_EXPLORER_URL=https://regtest.tachibtcscan.com

# Signet — Tachi daemon and its bitcoind (for deposits)
SIGNET_BTC_NODES=
SIGNET_BTC_RPC_URL=
SIGNET_BTC_RPC_USERNAME=
SIGNET_BTC_RPC_PASSWORD=
TACHI_SIGNET_SCAN_URL=https://signet.tachibtcscan.com

# Optional: server port (default 4402)
# PORT=4402
